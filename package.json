{
  "name": "chatgpt-tunnel-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local MCP bridge for project reading and automated ChatGPT-to-Codex task exchange",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/index.js",
    "dispatcher": "node dist/src/dispatcher/index.js",
    "test": "npm run build && node --test dist/test/**/*.test.js && node --test test/workflow.test.mjs",
    "workflow": "node scripts/workflow.mjs",
    "setup:local": "node scripts/setup-local.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "better-sqlite3": "12.2.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.1",
    "typescript": "^5.9.2"
  },
  "allowScripts": {
    "better-sqlite3@12.2.0": true
  }
}
